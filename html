<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JUNO TAROT</title>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    font-weight: 600;
    letter-spacing: -0.01em;
    min-height: 100vh;
    background:
      radial-gradient(ellipse at top, #2a1858 0%, #0d0620 50%, #000 100%);
    color: #f3e9d2;
    overflow-x: hidden;
    position: relative;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 20% 30%, #fff, transparent),
      radial-gradient(1px 1px at 60% 70%, #ffd, transparent),
      radial-gradient(1.5px 1.5px at 80% 10%, #fff, transparent),
      radial-gradient(1px 1px at 40% 80%, #ffecc8, transparent),
      radial-gradient(1px 1px at 90% 50%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 10% 60%, #fff, transparent),
      radial-gradient(1px 1px at 30% 15%, #ffd, transparent),
      radial-gradient(1px 1px at 70% 40%, #fff, transparent);
    background-size: 800px 800px;
    opacity: 0.6;
    animation: twinkle 5s infinite alternate;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.8; }
  }

  .container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 20px 80px;
    text-align: center;
  }

  h1 {
    font-family: 'Pretendard', sans-serif;
    font-size: 3.2rem;
    letter-spacing: 0.25em;
    background: linear-gradient(90deg, #e7c77a, #fff4c8, #e7c77a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 0 30px rgba(231, 199, 122, 0.3);
    margin-bottom: 4px;
    font-weight: 800;
  }
  input, button, h1, h2, h3, p, div, span, label, small {
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  }
  .subtitle {
    color: #b8a6d4;
    letter-spacing: 0.4em;
    font-size: 0.85rem;
    margin-bottom: 8px;
  }
  .tagline {
    color: #8a7aa0;
    font-size: 0.8rem;
    margin-bottom: 24px;
    letter-spacing: 0.1em;
  }

  .question-box {
    background: rgba(30, 15, 60, 0.5);
    border: 1px solid rgba(231, 199, 122, 0.4);
    border-radius: 10px;
    padding: 16px;
    margin: 0 auto 24px;
    max-width: 600px;
    backdrop-filter: blur(4px);
  }
  .question-box label {
    display: block;
    margin-bottom: 8px;
    color: #e7c77a;
    font-size: 0.95rem;
  }
  .question-box input {
    width: 100%;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(231, 199, 122, 0.3);
    border-radius: 6px;
    color: #f3e9d2;
    font-family: inherit;
    font-size: 1rem;
  }
  .question-box input:focus {
    outline: none;
    border-color: #e7c77a;
    box-shadow: 0 0 10px rgba(231, 199, 122, 0.3);
  }

  .btn {
    background: linear-gradient(135deg, #6b46c1, #4c1d95);
    color: #f3e9d2;
    border: 1px solid rgba(231, 199, 122, 0.6);
    padding: 14px 36px;
    font-size: 1.1rem;
    font-family: inherit;
    letter-spacing: 0.1em;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s;
    margin: 8px;
    box-shadow: 0 4px 15px rgba(107, 70, 193, 0.4);
  }
  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(231, 199, 122, 0.5);
    background: linear-gradient(135deg, #7c3aed, #5b21b6);
  }
  .btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }

  .spread {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin: 40px 0;
    flex-wrap: wrap;
    min-height: 340px;
  }

  .card-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 200px;
  }

  .card-label {
    font-size: 1rem;
    color: #e7c77a;
    letter-spacing: 0.25em;
    margin-bottom: 12px;
    opacity: 0.9;
  }
  .card-label small {
    display: block;
    color: #8a7aa0;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    margin-top: 2px;
  }

  .card {
    width: 190px;
    height: 320px;
    position: relative;
    cursor: pointer;
    perspective: 1200px;
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.9s cubic-bezier(0.4, 0.2, 0.2, 1);
    -webkit-transform-style: preserve-3d;
    transform-style: preserve-3d;
  }
  .card.no-transition .card-inner {
    transition: none !important;
  }

  .card.flipped .card-inner {
    transform: rotateY(180deg);
  }

  .card-face {
    position: absolute;
    inset: 0;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(107, 70, 193, 0.3);
  }

  /* 카드 뒷면 */
  .card-back {
    background:
      linear-gradient(135deg, #1a0a3e 0%, #3d1a78 50%, #1a0a3e 100%);
    border: 3px solid #e7c77a;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-back::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(231, 199, 122, 0.5);
    border-radius: 6px;
  }
  .card-back-symbol {
    width: 90px;
    height: 90px;
    background: radial-gradient(circle, #e7c77a 0%, #9a7a3a 70%);
    border-radius: 50%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 25px rgba(231, 199, 122, 0.6);
  }
  .card-back-symbol::before {
    content: '✦';
    font-size: 3.2rem;
    color: #1a0a3e;
  }
  .card-back-symbol::after {
    content: '';
    position: absolute;
    inset: -22px;
    border: 1px dashed rgba(231, 199, 122, 0.5);
    border-radius: 50%;
    animation: rotate 20s linear infinite;
  }
  @keyframes rotate {
    to { transform: rotate(360deg); }
  }

  /* 카드 앞면 - 이미지 기반 */
  .card-front {
    background: #f5ecd2;
    -webkit-transform: rotateY(180deg);
    transform: rotateY(180deg);
    border: 3px solid #4c1d95;
    display: flex;
    flex-direction: column;
    padding: 0;
  }
  .card-front.reversed .card-img-wrap {
    transform: rotate(180deg);
  }
  .card-img-wrap {
    flex: 1;
    width: 100%;
    height: 100%;
    background: #f5ecd2;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }
  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  /* 이미지 로드 실패 시 폴백 */
  .card-img-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, #f9e8b0, #e7c77a, #c79e50);
    color: #2a1858;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 14px 10px;
  }
  .card-img-fallback .n { font-size: 0.75rem; font-weight: bold; color: #4c1d95; }
  .card-img-fallback .sym { font-size: 4rem; }
  .card-img-fallback .nm { font-size: 0.95rem; font-weight: bold; border-top: 1px solid #4c1d95; padding-top: 6px; width: 100%; text-align: center; line-height: 1.2; }

  .card.appearing {
    animation: dealIn 0.6s ease-out;
  }
  @keyframes dealIn {
    from { opacity: 0; transform: translateY(-100px) rotate(-10deg) scale(0.8); }
    to { opacity: 1; transform: translateY(0) rotate(0) scale(1); }
  }

  .readings {
    margin-top: 40px;
    display: grid;
    gap: 20px;
  }
  .reading-card {
    background: rgba(30, 15, 60, 0.6);
    border: 1px solid rgba(231, 199, 122, 0.3);
    border-radius: 12px;
    padding: 24px;
    text-align: left;
    backdrop-filter: blur(6px);
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.6s forwards;
  }
  .reading-card:nth-child(1) { animation-delay: 0.2s; }
  .reading-card:nth-child(2) { animation-delay: 0.4s; }
  .reading-card:nth-child(3) { animation-delay: 0.6s; }
  .reading-card:nth-child(4) { animation-delay: 0.8s; }
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .reading-position {
    color: #e7c77a;
    letter-spacing: 0.25em;
    font-size: 0.8rem;
    margin-bottom: 8px;
  }
  .reading-title {
    font-size: 1.4rem;
    color: #fff;
    margin-bottom: 4px;
  }
  .reading-orientation {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 10px;
    font-size: 0.75rem;
    margin-bottom: 12px;
    letter-spacing: 0.1em;
  }
  .reading-orientation.upright {
    background: rgba(76, 175, 80, 0.25);
    color: #81e8a4;
    border: 1px solid #81e8a4;
  }
  .reading-orientation.reversed {
    background: rgba(220, 83, 83, 0.25);
    color: #ff9b9b;
    border: 1px solid #ff9b9b;
  }
  .reading-keywords {
    color: #c4b5e0;
    font-size: 0.92rem;
    margin-bottom: 10px;
    font-style: italic;
  }
  .reading-text {
    color: #e3d7c3;
    line-height: 1.75;
    font-size: 0.98rem;
  }

  .summary-card {
    background: linear-gradient(135deg, rgba(107, 70, 193, 0.4), rgba(76, 29, 149, 0.4));
    border: 1px solid #e7c77a;
  }
  .summary-card .reading-title {
    color: #e7c77a;
  }

  .hidden { display: none !important; }

  @media (max-width: 700px) {
    h1 { font-size: 2.2rem; letter-spacing: 0.15em; }
    .card { width: 145px; height: 245px; }
    .spread { gap: 15px; }
  }
</style>
</head>
<body>
<div class="container">
  <h1>JUNO TAROT</h1>
  <div class="subtitle">RIDER · WAITE · SMITH</div>
  <div class="tagline">과거 — 현재 — 미래 · 쓰리 카드 스프레드</div>

  <div class="question-box">
    <label for="question">마음속 질문을 적어 주세요 (선택)</label>
    <input type="text" id="question" placeholder="예: 지금 진행 중인 이 일을 계속해도 될까?" maxlength="100">
  </div>

  <div>
    <button class="btn" id="drawBtn">카드 뽑기</button>
    <button class="btn hidden" id="resetBtn">다시 뽑기</button>
  </div>

  <div class="spread" id="spread">
    <div class="card-slot">
      <div class="card-label">과거<small>PAST</small></div>
      <div class="card" data-index="0">
        <div class="card-inner">
          <div class="card-face card-back"><div class="card-back-symbol"></div></div>
          <div class="card-face card-front"></div>
        </div>
      </div>
    </div>
    <div class="card-slot">
      <div class="card-label">현재<small>PRESENT</small></div>
      <div class="card" data-index="1">
        <div class="card-inner">
          <div class="card-face card-back"><div class="card-back-symbol"></div></div>
          <div class="card-face card-front"></div>
        </div>
      </div>
    </div>
    <div class="card-slot">
      <div class="card-label">미래<small>FUTURE</small></div>
      <div class="card" data-index="2">
        <div class="card-inner">
          <div class="card-face card-back"><div class="card-back-symbol"></div></div>
          <div class="card-face card-front"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="readings" id="readings"></div>
</div>

<script>
// ============ 이미지 URL 생성기 (Wikimedia Commons - Rider-Waite-Smith, Public Domain) ============
const IMG_BASE = "https://commons.wikimedia.org/wiki/Special:FilePath/";
function imgUrl(filename) {
  return IMG_BASE + encodeURIComponent(filename) + "?width=400";
}

// ============ 메이저 아르카나 22장 (Rider-Waite 표준 해석 · 직설적 톤) ============
const MAJOR = [
  { n: "0", name: "바보", en: "The Fool", file: "RWS_Tarot_00_Fool.jpg", symbol: "🌼",
    up: { kw: "새로운 시작 · 모험 · 순수한 신뢰",
          t: "새 출발이다. 망설이지 말고 떠나라. 지금은 경험이 없는 게 오히려 무기다. 너무 재고 계산하면 기회를 놓친다." },
    rv: { kw: "무모함 · 준비 부족 · 어리석은 선택",
          t: "지금 뛰어들면 다친다. 준비가 덜 됐다는 걸 스스로 안다. 현실 감각을 되찾아라." } },
  { n: "I", name: "마법사", en: "The Magician", file: "RWS_Tarot_01_Magician.jpg", symbol: "✨",
    up: { kw: "의지 · 실행력 · 자원의 집중",
          t: "원하는 걸 이룰 수단을 이미 다 갖고 있다. 핑계 대지 말고 실행해라. 집중하면 지금 바로 된다." },
    rv: { kw: "기만 · 능력 낭비 · 미숙함",
          t: "재능을 엉뚱한 곳에 쓰고 있거나, 남의 말에 현혹되고 있다. 스스로를 속이지 마라." } },
  { n: "II", name: "여사제", en: "The High Priestess", file: "RWS_Tarot_02_High_Priestess.jpg", symbol: "🌙",
    up: { kw: "직관 · 비밀 · 아직 말할 때가 아님",
          t: "지금은 움직이지 말고 지켜봐라. 조용히 관찰하면 답이 나온다. 말을 아껴야 얻는다." },
    rv: { kw: "직관 무시 · 숨겨진 의도 · 정보 부족",
          t: "뭔가 이상한 느낌이 드는데 애써 무시하고 있다. 직감을 믿어라. 숨겨진 사실이 곧 드러난다." } },
  { n: "III", name: "여황제", en: "The Empress", file: "RWS_Tarot_03_Empress.jpg", symbol: "🌿",
    up: { kw: "풍요 · 창조 · 관계의 성장",
          t: "결과가 풍성하게 나올 시기다. 관계·프로젝트·몸 상태 모두 잘 자란다. 누리고 돌봐라." },
    rv: { kw: "정체 · 자기 소홀 · 창조성 고갈",
          t: "자기 자신을 뒷전으로 미뤘다. 먼저 챙기지 않으면 아무것도 키워낼 수 없다." } },
  { n: "IV", name: "황제", en: "The Emperor", file: "RWS_Tarot_04_Emperor.jpg", symbol: "👑",
    up: { kw: "권위 · 규율 · 안정된 구조",
          t: "질서와 규칙이 답이다. 감정으로 밀어붙이지 말고 체계적으로 움직여라. 책임지는 자리에 서라." },
    rv: { kw: "독단 · 경직 · 통제력 상실",
          t: "고집 때문에 손해 보고 있다. 한 번 내 방식이 틀릴 수도 있다는 걸 인정해라." } },
  { n: "V", name: "교황", en: "The Hierophant", file: "RWS_Tarot_05_Hierophant.jpg", symbol: "⛪",
    up: { kw: "전통 · 제도 · 검증된 길",
          t: "정석대로 가라. 튀는 방법보다 기본기와 전통이 먹힌다. 멘토·선배에게 조언을 구해라." },
    rv: { kw: "관습 거부 · 위선 · 자기만의 길",
          t: "기존 틀이 더 이상 안 맞는다. 형식을 깨라. 단, 결과에 대한 책임은 본인 몫이다." } },
  { n: "VI", name: "연인", en: "The Lovers", file: "RWS_Tarot_06_Lovers.jpg", symbol: "💞",
    up: { kw: "사랑 · 중요한 선택 · 가치관 일치",
          t: "진심에 맞는 선택을 해야 한다. 둘 중 하나는 포기해야 한다. 가치관과 일치하는 쪽을 골라라." },
    rv: { kw: "불화 · 잘못된 선택 · 유혹",
          t: "지금 관계나 선택이 어긋나 있다. 단기 쾌락에 흔들리면 길게 후회한다." } },
  { n: "VII", name: "전차", en: "The Chariot", file: "RWS_Tarot_07_Chariot.jpg", symbol: "🏛️",
    up: { kw: "의지력 · 승리 · 빠른 진전",
          t: "밀어붙이면 이긴다. 감정과 충동을 통제하고 목표 하나에만 집중해라. 속도를 내라." },
    rv: { kw: "방향 상실 · 통제 불능 · 공격성",
          t: "방향도 없이 세게만 달리고 있다. 멈추고 목적지부터 다시 정해라." } },
  { n: "VIII", name: "힘", en: "Strength", file: "RWS_Tarot_08_Strength.jpg", symbol: "🦁",
    up: { kw: "용기 · 자제력 · 부드러운 지배",
          t: "힘으로 누르지 말고 꾸준함과 차분함으로 이겨라. 네 안의 사자는 길들일 수 있다." },
    rv: { kw: "자기의심 · 감정 폭주 · 약함",
          t: "자기 자신을 못 믿고 있다. 두려움이 판단을 흐린다. 작은 성공부터 다시 쌓아라." } },
  { n: "IX", name: "은둔자", en: "The Hermit", file: "RWS_Tarot_09_Hermit.jpg", symbol: "🕯️",
    up: { kw: "성찰 · 혼자만의 시간 · 내면의 빛",
          t: "혼자 있는 시간이 필요하다. 남들 말을 끄고 스스로 답을 찾아라. 진짜 중요한 건 안에 있다." },
    rv: { kw: "고립 · 회피 · 외로움",
          t: "너무 오래 혼자 있었다. 이제는 세상으로 나와야 한다. 안 그러면 답도 멈춘다." } },
  { n: "X", name: "운명의 수레바퀴", en: "Wheel of Fortune", file: "RWS_Tarot_10_Wheel_of_Fortune.jpg", symbol: "🎡",
    up: { kw: "전환점 · 행운의 변화 · 사이클",
          t: "흐름이 바뀐다. 지금 상황은 오래 가지 않는다. 좋은 쪽으로 기회가 오니 놓치지 마라." },
    rv: { kw: "불운 · 반복 · 저항",
          t: "같은 실수를 계속하고 있다. 패턴을 끊지 않으면 상황은 안 바뀐다." } },
